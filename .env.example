# ============================================================
# INNAR GESTIÓN — Variables de entorno
# Copie este archivo como .env y configure los valores
# NUNCA suba el archivo .env a control de versiones
# ============================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=innar_gestion

PORT=3001
NODE_ENV=development

# Genere un secreto fuerte, mínimo 32 caracteres aleatorios:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CAMBIE_ESTO_POR_UN_SECRETO_FUERTE_ALEATORIO

FRONTEND_URL=http://localhost:3001

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

CSP_ENABLED=true
CSP_REPORT_ONLY=true

API_RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_MAX=40

# ------------------------------------------------------------
# ACCESO POR CORREO (contraseña temporal de un solo uso)
# ------------------------------------------------------------
ADMIN_EMAIL=admin@innar.local
OTP_EXPIRY_MINUTES=10

# SMTP — Gmail (igual que la web de hojas de vida)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------------
# ARCHIVOS Y RESPALDOS
# En producción (Hostinger) apunta estas carpetas FUERA de la app
# para que un deploy no borre PDFs ni fotos.
# Ejemplo Linux: /home/USUARIO/innar-gestion-data/uploads
# ------------------------------------------------------------
UPLOAD_DIR=uploads
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe

